{
  "Routes": [
    {
      "UpstreamPathTemplate": "/gateway/auth/{everything}",
      "UpstreamHttpMethod": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "authservice", "Port": 5025 }],
      "SwaggerKey": "auth"
    },
    {
      "UpstreamPathTemplate": "/gateway/applications/{everything}",
      "UpstreamHttpMethod": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      "DownstreamPathTemplate": "/api/applications/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "applicationservice", "Port": 5256 }],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "GatewayJwt",
        "AllowedScopes": []
      },
      "SwaggerKey": "applications"
    },
    {
      "UpstreamPathTemplate": "/gateway/documents/{everything}",
      "UpstreamHttpMethod": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      "DownstreamPathTemplate": "/api/documents/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "documentservice", "Port": 5262 }],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "GatewayJwt",
        "AllowedScopes": []
      },
      "SwaggerKey": "documents"
    },
    {
      "UpstreamPathTemplate": "/gateway/admin/{everything}",
      "UpstreamHttpMethod": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      "DownstreamPathTemplate": "/api/admin/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "adminservice", "Port": 5088 }],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "GatewayJwt",
        "AllowedScopes": []
      },
      "RouteClaimsRequirement": {
        "Role": "ADMIN"
      },
      "SwaggerKey": "admin"
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "auth",
      "TransformByOcelotConfig": true,
      "Config": [
        {
          "Name": "Auth Service",
          "Version": "v1",
          "Url": "http://authservice:5025/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "applications",
      "TransformByOcelotConfig": true,
      "Config": [
        {
          "Name": "Application Service",
          "Version": "v1",
          "Url": "http://applicationservice:5256/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "documents",
      "TransformByOcelotConfig": true,
      "Config": [
        {
          "Name": "Document Service",
          "Version": "v1",
          "Url": "http://documentservice:5262/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "admin",
      "TransformByOcelotConfig": true,
      "Config": [
        {
          "Name": "Admin Service",
          "Version": "v1",
          "Url": "http://adminservice:5088/swagger/v1/swagger.json"
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8002"
  }
}
