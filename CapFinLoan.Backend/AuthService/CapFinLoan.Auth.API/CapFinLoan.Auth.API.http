@CapFinLoan.Auth.API_HostAddress = http://localhost:5025

### Request OTP for signup
POST {{CapFinLoan.Auth.API_HostAddress}}/api/auth/signup/send-otp
Content-Type: application/json

{
  "email": "john@example.com"
}

### Signup - Create a new applicant account
POST {{CapFinLoan.Auth.API_HostAddress}}/api/auth/signup
Content-Type: application/json

{
  "name": "John Applicant",
  "email": "john@example.com",
  "phoneNumber": "+15550001111",
  "password": "Test@1234",
  "role": "APPLICANT",
  "otpCode": "123456"
}

### Login - Authenticate with email and password
POST {{CapFinLoan.Auth.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "john@example.com",
  "password": "Test@1234"
}

### Admin Signup
POST {{CapFinLoan.Auth.API_HostAddress}}/api/auth/signup
Content-Type: application/json

{
  "name": "Admin User",
  "email": "admin@capfinloan.com",
  "phoneNumber": "+15550002222",
  "password": "AdminPass@123",
  "role": "ADMIN",
  "otpCode": "123456"
}
