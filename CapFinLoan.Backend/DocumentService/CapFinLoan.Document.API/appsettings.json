{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=CapFinLoanDb;Trusted_Connection=True;"
  },
  "JwtSettings": {
    "Key": "THIS_IS_A_TRAINING_SECRET_KEY_CHANGE_ME_IN_PRODUCTION_2026",
    "Issuer": "CapFinLoan.AuthService",
    "Audience": "CapFinLoan.Client",
    "ExpiryMinutes": 120
  },
  "FileStorage": {
    "UploadRootPath": "Uploads",
    "MaxFileSizeInMb": 5,
    "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png" ]
  },
  "ApplicationService": {
    "BaseUrl": "http://localhost:5256",
    "ValidationPath": "/api/applications/{applicationId}/status",
    "DocumentStatusPath": "/internal/applications/{applicationId}/status",
    "RequireValidation": true,
    "StatusSyncEnabled": true,
    "StatusSyncMode": "RabbitMqPrimary"
  },
  "RabbitMQ": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
